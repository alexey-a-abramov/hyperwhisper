#!/bin/bash
set -e

# ============================================================================
# HyperWhisper Unified Build Script
# ============================================================================
# Default: Build local only
# With 'cloud'/'github'/'action': Build local first, then cloud, download artifacts
# ============================================================================

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GRADLE_PROPS="$SCRIPT_DIR/gradle.properties"
AAPT2_LINE="android.aapt2FromMavenOverride=/data/data/com.termux/files/usr/bin/aapt2"
WORKFLOW_NAME="build-apks.yml"
REPO="alexey-a-abramov/hyperwhisper"
DOWNLOAD_DIR="builds/downloads"

# ============================================================================
# Usage Information
# ============================================================================
show_usage() {
    echo -e "${CYAN}════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}   HyperWhisper Unified Build Script${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "${YELLOW}USAGE:${NC}"
    echo -e "  ./built [MODE] [FLAVOR]"
    echo ""
    echo -e "${YELLOW}MODES:${NC}"
    echo -e "  ${GREEN}(none)${NC}          Build locally (default)"
    echo -e "  ${GREEN}cloud${NC}           Build local first, then trigger cloud build & download"
    echo -e "  ${GREEN}github${NC}          Alias for 'cloud'"
    echo -e "  ${GREEN}action${NC}          Alias for 'cloud'"
    echo ""
    echo -e "${YELLOW}FLAVORS (for local build):${NC}"
    echo -e "  ${GREEN}local${NC}           Build local flavor only (default, with whisper.cpp)"
    echo -e "  ${GREEN}cloud${NC}           Build cloud flavor only (cloud APIs only)"
    echo -e "  ${GREEN}both${NC}            Build both flavors"
    echo ""
    echo -e "${YELLOW}EXAMPLES:${NC}"
    echo -e "  ${BLUE}./built${NC}                    # Build local flavor locally"
    echo -e "  ${BLUE}./built local${NC}              # Build local flavor locally"
    echo -e "  ${BLUE}./built cloud${NC}              # Build cloud flavor locally"
    echo -e "  ${BLUE}./built both${NC}               # Build both flavors locally"
    echo -e "  ${BLUE}./built github${NC}             # Build local, trigger cloud build & download"
    echo -e "  ${BLUE}./built action local${NC}       # Build local, trigger cloud build for local flavor"
    echo ""
    echo -e "${YELLOW}OUTPUT LOCATIONS:${NC}"
    echo -e "  Local builds:  ${BLUE}builds/local/app-local-debug.apk${NC}"
    echo -e "                 ${BLUE}builds/cloud/app-cloud-debug.apk${NC}"
    echo -e "  Cloud builds:  ${BLUE}builds/downloads/latest/${NC}"
    echo ""
}

# ============================================================================
# Local Build Function
# ============================================================================
build_local() {
    local FLAVOR="${1:-local}"

    echo -e "${BLUE}════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}   Local Build - $FLAVOR Flavor${NC}"
    echo -e "${BLUE}════════════════════════════════════════════════${NC}"
    echo ""

    # Validate flavor
    VALID_FLAVORS=("cloud" "local" "both")
    if [[ ! " ${VALID_FLAVORS[@]} " =~ " ${FLAVOR} " ]]; then
        echo -e "${RED}❌ Invalid flavor: $FLAVOR${NC}"
        echo -e "Valid flavors: local, cloud, both"
        exit 1
    fi

    # Check if running on Android
    if [[ ! -d "/data/data/com.termux" ]]; then
        echo -e "${YELLOW}⚠️  Warning: Not running on Termux/Android${NC}"
        echo -e "This script is optimized for Android/Termux environment."
        echo ""
    fi

    # Backup gradle.properties
    echo -e "${BLUE}📦 Backing up gradle.properties...${NC}"
    cp "$GRADLE_PROPS" "$GRADLE_PROPS.bak"

    # Function to restore gradle.properties
    restore_gradle_props() {
        if [[ -f "$GRADLE_PROPS.bak" ]]; then
            echo -e "${BLUE}🔄 Restoring gradle.properties...${NC}"
            mv "$GRADLE_PROPS.bak" "$GRADLE_PROPS"
        fi
    }

    # Trap to ensure restoration even on error
    trap restore_gradle_props EXIT

    # Configure AAPT2 for ARM64 if on Termux
    if [[ -d "/data/data/com.termux" ]]; then
        echo -e "${BLUE}🔧 Configuring ARM64 AAPT2...${NC}"
        sed -i "s|# $AAPT2_LINE|$AAPT2_LINE|g" "$GRADLE_PROPS"

        # Verify AAPT2 is available
        if [[ ! -f "/data/data/com.termux/files/usr/bin/aapt2" ]]; then
            echo -e "${RED}❌ Error: AAPT2 not found${NC}"
            echo -e "Install it with: ${YELLOW}pkg install aapt2${NC}"
            exit 1
        fi
        echo -e "${GREEN}✓ AAPT2 configured${NC}"
    fi
    echo ""

    # Build function for individual flavor
    build_flavor() {
        local flavor_name=$1
        local gradle_task=$2

        echo -e "${BLUE}════════════════════════════════════════════════${NC}"
        echo -e "${BLUE}Building $flavor_name flavor...${NC}"
        echo -e "${BLUE}════════════════════════════════════════════════${NC}"
        echo ""

        START_TIME=$(date +%s)

        if ./gradlew "$gradle_task" --stacktrace; then
            END_TIME=$(date +%s)
            DURATION=$((END_TIME - START_TIME))
            MINUTES=$((DURATION / 60))
            SECONDS=$((DURATION % 60))

            echo ""
            echo -e "${GREEN}✅ $flavor_name build completed successfully!${NC}"
            echo -e "${GREEN}⏱️  Build time: ${MINUTES}m ${SECONDS}s${NC}"
            echo ""

            # Show APK location
            APK_PATH="builds/${flavor_name,,}/app-${flavor_name,,}-debug.apk"
            if [[ -f "$APK_PATH" ]]; then
                APK_SIZE=$(du -h "$APK_PATH" | cut -f1)
                APK_FULL_PATH=$(realpath "$APK_PATH")
                echo -e "${GREEN}📱 APK Location:${NC}"
                echo -e "   $APK_FULL_PATH"
                echo -e "${GREEN}📦 Size:${NC} $APK_SIZE"
                echo ""
            fi

            return 0
        else
            END_TIME=$(date +%s)
            DURATION=$((END_TIME - START_TIME))
            MINUTES=$((DURATION / 60))
            SECONDS=$((DURATION % 60))

            echo ""
            echo -e "${RED}❌ $flavor_name build failed after ${MINUTES}m ${SECONDS}s${NC}"
            echo ""
            return 1
        fi
    }

    # Build based on flavor
    BUILD_SUCCESS=true

    if [[ "$FLAVOR" == "both" ]] || [[ "$FLAVOR" == "cloud" ]]; then
        if ! build_flavor "Cloud" "assembleCloudDebug"; then
            BUILD_SUCCESS=false
        fi
    fi

    if [[ "$FLAVOR" == "both" ]] || [[ "$FLAVOR" == "local" ]]; then
        if ! build_flavor "Local" "assembleLocalDebug"; then
            BUILD_SUCCESS=false
        fi
    fi

    # Summary
    echo -e "${BLUE}════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}Local Build Summary${NC}"
    echo -e "${BLUE}════════════════════════════════════════════════${NC}"
    echo ""

    if [[ "$BUILD_SUCCESS" == true ]]; then
        echo -e "${GREEN}✅ All local builds completed successfully!${NC}"
        echo ""
        echo -e "${YELLOW}📲 To install:${NC}"
        echo -e "   adb install \"<path-to-apk>\""
        echo ""
        return 0
    else
        echo -e "${RED}❌ Some local builds failed${NC}"
        echo ""
        return 1
    fi
}

# ============================================================================
# Cloud Build Function
# ============================================================================
build_cloud() {
    local FLAVOR="${1:-both}"

    echo -e "${CYAN}════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}   Cloud Build Mode${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════${NC}"
    echo ""

    # Determine which flavors to build in cloud
    BUILD_LOCAL_CLOUD=true
    BUILD_CLOUD_CLOUD=true

    if [[ "$FLAVOR" == "local" ]]; then
        BUILD_CLOUD_CLOUD=false
    elif [[ "$FLAVOR" == "cloud" ]]; then
        BUILD_LOCAL_CLOUD=false
    fi

    # Step 1: Push changes to GitHub
    echo -e "${YELLOW}[1/5] Pushing changes to GitHub...${NC}"
    if git push; then
        echo -e "${GREEN}✓ Changes pushed successfully${NC}"
    else
        echo -e "${RED}✗ Failed to push changes${NC}"
        exit 1
    fi
    echo ""

    # Step 2: Trigger GitHub Actions workflow
    echo -e "${YELLOW}[2/5] Triggering cloud build workflow...${NC}"
    if gh workflow run "$WORKFLOW_NAME" \
        --repo "$REPO" \
        --field build_local=$BUILD_LOCAL_CLOUD \
        --field build_cloud=$BUILD_CLOUD_CLOUD; then
        echo -e "${GREEN}✓ Workflow triggered${NC}"
    else
        echo -e "${RED}✗ Failed to trigger workflow${NC}"
        exit 1
    fi
    echo ""

    # Wait for workflow to appear
    echo -e "${BLUE}Waiting 5 seconds for workflow to start...${NC}"
    sleep 5
    echo ""

    # Step 3: Get the latest workflow run ID
    echo -e "${YELLOW}[3/5] Finding workflow run...${NC}"
    RUN_ID=$(gh run list \
        --repo "$REPO" \
        --workflow "$WORKFLOW_NAME" \
        --limit 1 \
        --json databaseId \
        --jq '.[0].databaseId')

    if [ -z "$RUN_ID" ]; then
        echo -e "${RED}✗ Could not find workflow run${NC}"
        exit 1
    fi

    echo -e "${GREEN}✓ Found workflow run: #$RUN_ID${NC}"
    echo ""

    # Step 4: Watch workflow status
    echo -e "${YELLOW}[4/5] Monitoring build progress...${NC}"
    echo -e "${BLUE}Press Ctrl+C to stop watching (build will continue in background)${NC}"
    echo ""

    if gh run watch "$RUN_ID" --repo "$REPO"; then
        echo -e "${GREEN}✓ Cloud build completed successfully!${NC}"
    else
        echo -e "${RED}✗ Cloud build failed or was cancelled${NC}"
        echo ""
        echo -e "${YELLOW}Fetching logs...${NC}"
        gh run view "$RUN_ID" --repo "$REPO" --log-failed
        exit 1
    fi
    echo ""

    # Step 5: Download artifacts
    echo -e "${YELLOW}[5/5] Downloading APK and logs...${NC}"

    # Create output directory with timestamp
    TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
    BUILD_DIR="$DOWNLOAD_DIR/$TIMESTAMP"
    mkdir -p "$BUILD_DIR"

    echo -e "${BLUE}Output directory: $BUILD_DIR${NC}"
    echo ""

    # Download cloud APK artifact
    if [[ "$BUILD_CLOUD_CLOUD" == true ]]; then
        echo -e "${BLUE}Downloading cloud APK...${NC}"
        if gh run download "$RUN_ID" \
            --repo "$REPO" \
            --name "hyperwhisper-cloud-debug" \
            --dir "$BUILD_DIR/cloud"; then
            echo -e "${GREEN}✓ Cloud APK downloaded${NC}"

            APK_FILE=$(find "$BUILD_DIR/cloud" -name "*.apk" -type f)
            if [ -n "$APK_FILE" ]; then
                APK_SIZE=$(du -h "$APK_FILE" | cut -f1)
                echo -e "${GREEN}  File: $(basename "$APK_FILE")${NC}"
                echo -e "${GREEN}  Size: $APK_SIZE${NC}"
                echo -e "${GREEN}  Path: $APK_FILE${NC}"
            fi
        else
            echo -e "${RED}✗ Failed to download cloud APK${NC}"
        fi
        echo ""
    fi

    # Download local APK artifact
    if [[ "$BUILD_LOCAL_CLOUD" == true ]]; then
        echo -e "${BLUE}Downloading local APK...${NC}"
        if gh run download "$RUN_ID" \
            --repo "$REPO" \
            --name "hyperwhisper-local-debug" \
            --dir "$BUILD_DIR/local" 2>/dev/null; then
            echo -e "${GREEN}✓ Local APK downloaded${NC}"

            APK_FILE_LOCAL=$(find "$BUILD_DIR/local" -name "*.apk" -type f)
            if [ -n "$APK_FILE_LOCAL" ]; then
                APK_SIZE_LOCAL=$(du -h "$APK_FILE_LOCAL" | cut -f1)
                echo -e "${GREEN}  File: $(basename "$APK_FILE_LOCAL")${NC}"
                echo -e "${GREEN}  Size: $APK_SIZE_LOCAL${NC}"
                echo -e "${GREEN}  Path: $APK_FILE_LOCAL${NC}"
            fi
        else
            echo -e "${YELLOW}⚠ Local APK not available${NC}"
        fi
        echo ""
    fi

    # Download build logs
    echo -e "${BLUE}Downloading build logs...${NC}"
    if gh run view "$RUN_ID" \
        --repo "$REPO" \
        --log > "$BUILD_DIR/build.log"; then
        echo -e "${GREEN}✓ Build logs saved${NC}"
    else
        echo -e "${YELLOW}⚠ Could not download logs${NC}"
    fi
    echo ""

    # Save workflow summary
    echo -e "${BLUE}Saving workflow summary...${NC}"
    gh run view "$RUN_ID" \
        --repo "$REPO" > "$BUILD_DIR/summary.txt"
    echo -e "${GREEN}✓ Summary saved${NC}"
    echo ""

    # Create "latest" symlink
    LATEST_LINK="$DOWNLOAD_DIR/latest"
    if [ -L "$LATEST_LINK" ]; then
        rm "$LATEST_LINK"
    fi
    cd "$DOWNLOAD_DIR"
    ln -s "$TIMESTAMP" "latest"
    cd - > /dev/null
    echo -e "${GREEN}✓ Created symlink: $DOWNLOAD_DIR/latest -> $TIMESTAMP${NC}"
    echo ""

    # Final summary
    echo -e "${CYAN}════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}Cloud Build Complete!${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "Build artifacts location:"
    echo -e "  ${BLUE}$BUILD_DIR/${NC}"
    echo ""
    echo -e "Quick access:"
    echo -e "  ${BLUE}Latest: $DOWNLOAD_DIR/latest/${NC}"
    echo ""
    echo -e "${GREEN}To install APKs:${NC}"
    if [ -n "$APK_FILE" ]; then
        echo -e "  ${BLUE}adb install \"$APK_FILE\"${NC} (cloud)"
    fi
    if [ -n "$APK_FILE_LOCAL" ]; then
        echo -e "  ${BLUE}adb install \"$APK_FILE_LOCAL\"${NC} (local)"
    fi
    echo ""
}

# ============================================================================
# Main Script Logic
# ============================================================================

# Show usage info
show_usage

# Parse arguments
MODE="${1:-local}"
FLAVOR="${2:-local}"

# Normalize mode
case "$MODE" in
    cloud|github|action)
        # Cloud build mode: build local first, then cloud
        echo -e "${YELLOW}Step 1: Building locally first...${NC}"
        echo ""
        if build_local "$FLAVOR"; then
            echo ""
            echo -e "${YELLOW}Step 2: Triggering cloud build...${NC}"
            echo ""
            build_cloud "$FLAVOR"
        else
            echo -e "${RED}❌ Local build failed. Aborting cloud build.${NC}"
            exit 1
        fi
        ;;
    local|both)
        # Local build only
        build_local "$MODE"
        ;;
    *)
        # Treat as flavor for local build
        build_local "$MODE"
        ;;
esac
